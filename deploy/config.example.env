# Copia a deploy/config.env y completa los valores. config.env está ignorado.
VPS_HOST=tu-vps.example.com
SSH_USER=root
SSH_KEY=$HOME/.ssh/jireorinoco_vps
DOMAIN=jireorinoco.com
CERTBOT_EMAIL=tu-correo@ejemplo.com

# --- Tracker de conciliación de guías ---
TRACKER_DIR=$HOME/repo/guias-conciliacion
TRACKER_BRANCH=main
TRACKER_SUBDOMAIN=tracker
TRACKER_SOURCE_EMAIL=sistema@ejemplo.com
TRACKER_ADMIN_EMAIL=
# Vacío -> se genera y se muestra una vez.
TRACKER_ADMIN_PASSWORD=
TRACKER_ASSIGNMENT_SUBJECT_REGEX=
TRACKER_PAYMENT_SUBJECT_REGEX=
TRACKER_IMAP_MAILBOX=INBOX
TRACKER_OCR=false

OCR_DIR=$HOME/repo/Ocr_Processor
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
IMAP_HOST=imap.titan.email
IMAP_PORT=993
IMAP_USER=contact@jireorinoco.com
IMAP_PASS='cambiame'
IMAP_POLL_SECONDS=60
DEFAULT_OCR_LANGUAGE=spa
