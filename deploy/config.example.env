# Copia este archivo a deploy/config.env y completa los valores.
# deploy/config.env está en .gitignore (NO se sube — contiene secretos).

# --- VPS / SSH ---
VPS_HOST=187.77.235.150
SSH_USER=root
SSH_KEY=$HOME/.ssh/jireorinoco_vps

# --- Dominio / SSL ---
DOMAIN=jireorinoco.com
CERTBOT_EMAIL=tu-correo@ejemplo.com

# --- Rutas LOCALES de los repos privados (se envían al VPS por git archive) ---
# La landing se despliega desde este mismo repo (donde vive el script).
FACTURAS_DIR=$HOME/repo/automatizacion-facturas
FACTURAS_BRANCH=main
OCR_DIR=$HOME/repo/Ocr_Processor

# --- DeepSeek (LLM de extracción) ---
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# --- Correo a vigilar (IMAP Titan) para la automatización ---
IMAP_HOST=imap.titan.email
IMAP_PORT=993
IMAP_USER=contact@jireorinoco.com
# OJO: si la contraseña tiene caracteres especiales como ( ) espacios ! # &,
# enciérrala entre comillas simples para que `source` no falle. Ej:
#   IMAP_PASS='(Mi#Clave!Rara'
IMAP_PASS='cambiame'
IMAP_POLL_SECONDS=60

# --- OCR ---
DEFAULT_OCR_LANGUAGE=spa
